# HackChat env vars — copy to .env.local for local dev, or set in the
# Vercel dashboard (Project Settings → Environment Variables) for deploys.
# All three are optional: without them the app runs on a demo-only
# in-memory store (see lib/store.ts). Nothing real goes in this file.

# Vercel KV (Redis) — created in the Vercel dashboard under Storage.
# When set, rooms persist in KV. Without them, messages live in memory only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — created in the Vercel dashboard under Storage.
# When set, uploaded files go to Blob. Without it, files are kept in
# memory as base64 data URLs (demo-only, do not use for real files).
BLOB_READ_WRITE_TOKEN=
